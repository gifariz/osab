{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may do: OSAB commands, file dialogs, window title, theme and closing.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:window:allow-destroy",
    "dialog:default"
  ]
}
